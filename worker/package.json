{
  "name": "translation-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for translations and TTS",
  "main": "src/index.js",
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "export-content": "python ../worker/scripts/exportContentData.py",
    "translation": "node scripts/runTranslation.js",
    "run-translation": "node scripts/runTranslation.js",
    "cleanup-fallbacks": "node scripts/cleanupFallbackTranslations.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.370.0",
    "google-tts-api": "^2.0.2"
  },
  "devDependencies": {
    "wrangler": "^3.0.0",
    "dotenv": "^16.0.0"
  }
}
